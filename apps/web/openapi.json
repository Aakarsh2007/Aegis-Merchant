{
  "components": {
    "schemas": {
      "ActionRequest": {
        "additionalProperties": false,
        "description": "What a reviewer submits.\n\nNote what is *absent*: any field naming the reviewer. That comes from the\nbearer token. Accepting it here would let a caller authorise a six-figure\naction under someone else's name.",
        "properties": {
          "action": {
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Action",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "policy_applied_hash": {
            "maxLength": 64,
            "minLength": 64,
            "title": "Policy Applied Hash",
            "type": "string"
          }
        },
        "required": [
          "action",
          "policy_applied_hash"
        ],
        "title": "ActionRequest",
        "type": "object"
      },
      "CaseStatus": {
        "description": "Case lifecycle (workflow.md \u00a76.2). Terminal states have no outgoing edge.",
        "enum": [
          "DETECTED",
          "TRIAGED",
          "DIAGNOSING",
          "STRATEGY_FORMED",
          "AWAITING_APPROVAL",
          "EXECUTING",
          "MONITORING",
          "RECOVERED",
          "RESOLVED_ORGANIC",
          "OBSERVED_NO_ACTION",
          "EXPIRED",
          "SUPPRESSED",
          "REJECTED",
          "FAILED_PERMANENT"
        ],
        "title": "CaseStatus",
        "type": "string"
      },
      "DLQStatus": {
        "enum": [
          "OPEN",
          "REPLAYED",
          "ACKNOWLEDGED"
        ],
        "title": "DLQStatus",
        "type": "string"
      },
      "ExperimentArm": {
        "description": "CONTROL cases receive no intervention at all, so that recovery can be\nreported as incremental lift rather than asserted (workflow.md \u00a714.2).",
        "enum": [
          "TREATMENT",
          "CONTROL"
        ],
        "title": "ExperimentArm",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InjectRequest": {
        "additionalProperties": false,
        "properties": {
          "fault": {
            "enum": [
              "provider_down",
              "provider_slow",
              "provider_duplicate",
              "llm_quota_exhausted",
              "clear"
            ],
            "title": "Fault",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "fault"
        ],
        "title": "InjectRequest",
        "type": "object"
      },
      "Playbook": {
        "description": "The four revenue leaks (workflow.md \u00a75).",
        "enum": [
          "PAYMENT_FAILURE",
          "CHECKOUT_ABANDON",
          "RECEIVABLE",
          "SUBSCRIPTION"
        ],
        "title": "Playbook",
        "type": "string"
      },
      "TamperRequest": {
        "additionalProperties": false,
        "description": "Which block to corrupt, and how.",
        "properties": {
          "block_index": {
            "minimum": 0.0,
            "title": "Block Index",
            "type": "integer"
          },
          "mode": {
            "default": "payload",
            "pattern": "^(payload|hash|timestamp)$",
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "block_index"
        ],
        "title": "TamperRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Autonomous revenue recovery agent for Razorpay merchants. Bounded agent: the LLM diagnoses and writes; it never touches money.",
    "title": "RevPilot AI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/approvals": {
      "get": {
        "description": "Approvals awaiting a human.\n\nRows already past their TTL are reported as ``expired: true`` rather than\nhidden or silently omitted. A reviewer looking at a queue needs to see that\nsomething expired unactioned \u2014 that is a signal about their own response\ntime, and hiding it would make the queue look healthier than it is.",
        "operationId": "list_pending_api_v1_approvals_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response List Pending Api V1 Approvals Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Pending approvals, with the hash to present back",
        "tags": [
          "approvals"
        ]
      }
    },
    "/api/v1/approvals/{approval_id}/action": {
      "post": {
        "description": "Record a human decision.\n\nReturns 404 for an unknown approval, 409 for one that is already actioned\nor past its TTL, and 409 for a hash mismatch.",
        "operationId": "action_approval_api_v1_approvals__approval_id__action_post",
        "parameters": [
          {
            "in": "path",
            "name": "approval_id",
            "required": true,
            "schema": {
              "title": "Approval Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Action Approval Api V1 Approvals  Approval Id  Action Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Approve or reject a pending action",
        "tags": [
          "approvals"
        ]
      }
    },
