# RevPilot AI — environment configuration
#
# Copy to `.env` and fill in only what you want. EVERY value below has a
# working default: with no .env at all the app runs in Judge Mode — mock
# Razorpay provider, deterministic reasoning, zero credentials, zero cost.
#
# Progressive fidelity (workflow.md §22):
#   + RAZORPAY_KEY_ID/SECRET  -> real Razorpay Test Mode payment links
#   + GEMINI_API_KEY          -> live LLM reasoning (free tier)
#   + a Cloudflare Tunnel URL -> real signed inbound webhooks
# Each step is independent, and each is free.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database — SQLite WAL. No Postgres, no Docker, no Redis (ADL-003).
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./revpilot.db

# ---------------------------------------------------------------------------
# Razorpay TEST MODE (free). dashboard.razorpay.com -> Settings -> API Keys.
# Leave blank to use the mock provider.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WEBHOOK_REPLAY_TOLERANCE_S=300

# ---------------------------------------------------------------------------
# LLM — Google AI Studio free tier (free). aistudio.google.com/apikey
# Leave blank to run on the deterministic adapter (fully functional).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Free-tier quotas. VERIFY_CURRENT_QUOTA — these change; check AI Studio
# rather than trusting these numbers (workflow.md §4.6).
LLM_RPM_LIMIT=10
LLM_RPD_LIMIT=200
LLM_TIMEOUT_S=12.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_CALLS_PER_CASE=3

# Bumping this invalidates every response-cache key, forcing a fresh
# `warm-cache` run so a stale cache cannot silently pass CI.
PROMPT_VERSION=v1

# ---------------------------------------------------------------------------
# Policy firewall — every bound the agent cannot cross (§8, §26.2)
# ---------------------------------------------------------------------------
# Amounts in PAISE. ₹10,000 = 1000000 paise.
MAX_AUTONOMOUS_AMOUNT_PAISE=1000000
HITL_DUAL_SIGNAL_AMOUNT_PAISE=10000000

# Hard ceiling, and what a clamp resolves to. The clamp target is the safe
# default, not the ceiling — clamping to the ceiling would reward a model for
# asking high.
MAX_DISCOUNT_PCT=7.0
DEFAULT_DISCOUNT_PCT=5.0
MAX_DISCOUNT_ABSOLUTE_PAISE=50000

MAX_CONTACTS_24H=1
MAX_CONTACTS_48H=2
MAX_ATTEMPTS_PER_CASE=2
MAX_DISCOUNT_BEARING_ATTEMPTS=1

LINK_EXPIRY_MINUTES=30
LINK_EXPIRY_MIN_MINUTES=15
LINK_EXPIRY_MAX_MINUTES=1440

# TRAI-aligned quiet hours, IST. Outbound is DEFERRED to 09:05, never dropped.
QUIET_HOURS_START_IST=21
QUIET_HOURS_END_IST=9
QUIET_HOURS_RELEASE_MINUTE=5

# Recovery windows per playbook, in hours.
WINDOW_PAYMENT_FAILURE_H=24
WINDOW_CHECKOUT_ABANDON_H=72
WINDOW_RECEIVABLE_H=720
WINDOW_SUBSCRIPTION_H=168

APPROVAL_TTL_MINUTES=240
ATTRIBUTION_GRACE_H=24
PROMISE_FREEZE_H=24

# Per-merchant circuit breakers (stopping rule S-11).
DAILY_ACTION_BUDGET=50
MONTHLY_DISCOUNT_EXPOSURE_PAISE=20000000

# NPCI mandate rules. VERIFY_BEFORE_PRODUCTION — the mechanism is correct;
# re-check the exact numbers against the current NPCI circular.
PRE_DEBIT_NOTICE_HOURS=24
MAX_REPRESENTATIONS=3

# ---------------------------------------------------------------------------
# Measurement — the holdout control arm (§14.2)
# ---------------------------------------------------------------------------
# Fraction of eligible cases that receive NO intervention, so incremental lift
# is measurable rather than asserted. Setting this to 0 makes the headline
# recovery number unfalsifiable. Do not.
CONTROL_ARM_FRACTION=0.18
EXPERIMENT_KEY=revpilot_recovery_v1

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
OUTBOX_MAX_ATTEMPTS=4
OUTBOX_RECONCILE_AFTER_S=60

# ---------------------------------------------------------------------------
# Demo corpus — seeded RNG so the batch is reproducible byte-for-byte
# ---------------------------------------------------------------------------
SEED=20260905
SEED_TRANSACTION_COUNT=420
