# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# NOTE: apps/api/revpilot.db is the RUNTIME database and is ignored.
# The seeded, reproducible demo database is committed at data/revpilot.seed.db
# (see workflow.md §12.1) so a judge sees a populated dashboard on first load.
*.db
*.db-journal
*.db-wal
*.db-shm
!data/revpilot.seed.db

# ---------------------------------------------------------------------------
# Logs & local artefacts
# ---------------------------------------------------------------------------
logs/
*.log
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Archived pre-v3.1 implementation (kept on disk, never committed).
# The v3.1 build in apps/ is authoritative — see workflow.md §30 ADL-006.
# ---------------------------------------------------------------------------
legacy/

